# ============================================================================
# RS Bhakti Digital SIMRS - Environment Configuration
# ============================================================================

# Application Environment
NODE_ENV=development
APP_NAME="RS Bhakti Digital SIMRS"
APP_URL=http://localhost:8443
# Backend API Base URL (leave empty in local dev to use Vite proxy, set in production on Vercel)
VITE_API_URL=https://your-backend.vercel.app

# Backend Server Configuration
BACKEND_PORT=3001
JWT_SECRET=rs_bhakti_digital_enterprise_secret_2025
JWT_EXPIRES_IN=86400

# Relational Database (MySQL / PostgreSQL via FlyEnv / Local)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=rsbhakti_simrs
DB_USERNAME=simrs_user
DB_PASSWORD=simrs_password
DATABASE_URL="mysql://simrs_user:simrs_password@127.0.0.1:3306/rsbhakti_simrs"

# Alternative PostgreSQL Connection:
# DB_CONNECTION=pgsql
# DB_PORT=5432
# DATABASE_URL="postgresql://simrs_user:simrs_password@127.0.0.1:5432/rsbhakti_simrs?schema=public"

# Redis Cache & Queue
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=null

# BPJS Kesehatan Bridging Simulation
BPJS_CONS_ID=3171045
BPJS_SECRET_KEY=simrs_bpjs_bridge_key
BPJS_USER_KEY=simrs_user_key_2025
BPJS_BASE_URL=https://apijkn.bpjs-kesehatan.go.id/vclaim-rest/

# SatuSehat Kemenkes RI Bridging
SATUSEHAT_ENV=sandbox
SATUSEHAT_ORG_ID=10002481
SATUSEHAT_CLIENT_ID=satusehat_client_id
SATUSEHAT_CLIENT_SECRET=satusehat_client_secret
